#!/usr/bin/env bash

set -e

compile_args="$@"


#--------------------------------------------------------------
# functions
#--------------------------------------------------------------
usage() {
  cat << EOF
usage: $(basename $0) [-h] [-e EMULATOR] [-o OUPUT_DIR] [-c]

compile an emulation database in OUTPUT_DIR

where:
  -h                        : display this help
  -e EMULATOR               : veloce (default) or zebu
  -o OUTPUT_DIR             : build in OUTPUT_DIR
  -c                        : only compile the C code (host side), keep the emulation database

EOF
}


error() {
  >&2 echo "ERROR: $@"
  exit 1
}


banner() {
cat << EOF

#--------------------------------------------------------------
# $@
#--------------------------------------------------------------
EOF
}


compile_veloce() {
  local lib_dir=veloce_rundir
  local rtl_sv_lib=vel_sv_work

  cp -rf $emulation_dir/input/compilation/* .

  banner "veloce: lib"
  mkdir $lib_dir
  vellib $lib_dir/$rtl_sv_lib

  banner "veloce: analyze sv"
  velanalyze -sv -mfcu -work $rtl_sv_lib $MULTISIM_SRC/core/multisim_server_*.sv +define+MULTISIM_EMULATION
  velanalyze -sv -mfcu -work $rtl_sv_lib $emulation_dir/src/emu/*.sv

  banner "veloce: compilation"
  velcomp

}


compile_zebu() {
  $emulation_dir/../../zebu/compile_zebu $emulation_dir/src/emu/*.sv
}


#--------------------------------------------------------------
# execution
#--------------------------------------------------------------
output_dir="output"
emulator="veloce"
c_only=0

while [ "$#" -gt 0 ]
do
  case "$1" in
    -h)
      usage
      exit 0
      ;;
    -e)
      shift 1
      emulator=$1
      shift 1
      ;;
    -o)
      shift 1
      output_dir=$1
      shift 1
      ;;
    -c)
      shift 1
      c_only=1
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

[[ $emulator =~ ^(veloce|zebu)$ ]] || error "unknown emulator: $emulator"
output_dir=$(readlink -f $output_dir)
emulation_dir="$(readlink -e $(dirname $0))"

[[ $emulator == veloce ]] && dpi_cflags="-DMULTISIM_EMULATION -I${VELOCE_HOME}/tbx/include"
[[ $emulator == zebu ]] && dpi_cflags="-DMULTISIM_ZEBU -I${ZEBU_ROOT}/include"

if ((c_only)); then
  cd $output_dir
else
  banner "remove $output_dir"
  rm -rf $output_dir
  mkdir -p $output_dir
  cd $output_dir

  banner "compile_$emulator"
  compile_$emulator

  banner "copy runtime files"
  cp -rf $emulation_dir/input/runtime/* .

  banner "create info.txt"
  [[ $emulator == veloce ]] && (
  grep Frequency veloce.log/compile_* | sed 's/.*Freq/Freq/'
  grep 'Number of Boards' veloce.log/compile_* | sed 's/.*Boards/Boards/'
  ) > info.txt
fi

banner "compile C"
# server: libdpi.so, needed by the emulator at runtime
g++ -o libdpi.so -g -shared -fPIC             \
  $dpi_cflags                                 \
  $MULTISIM_SRC/core/multisim_server.cpp      \
  $MULTISIM_SRC/core/socket_server/server.cpp
